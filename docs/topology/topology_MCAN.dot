    "message:MCAN:INVA_TEMPS" [label="INVA_TEMPS\nID 0x461 (standard)\n500 ms · 6 bytes · priority 4", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:INVERTER_A" -> "message:MCAN:INVA_TEMPS" [label="TX"];
    "message:MCAN:INVA_TEMPS" -> "node:MCAN:MAIN_MODULE" [label="RX", style=dashed];

    "message:MCAN:INVB_TEMPS" [label="INVB_TEMPS\nID 0x462 (standard)\n500 ms · 6 bytes · priority 4", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:INVERTER_B" -> "message:MCAN:INVB_TEMPS" [label="TX"];
    "message:MCAN:INVB_TEMPS" -> "node:MCAN:MAIN_MODULE" [label="RX", style=dashed];

    "message:MCAN:INVC_TEMPS" [label="INVC_TEMPS\nID 0x463 (standard)\n500 ms · 6 bytes · priority 4", style="rounded,filled", fillcolor="#E0E0E0"];
