    "message:MCAN:INVD_INFO" -> "node:MCAN:MAIN_MODULE" [label="RX", style=dashed];

    "message:MCAN:main_hb_amk" [label="main_hb_amk\nID 0x235 (standard)\n500 ms · 2 bytes · priority 3", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:MAIN_MODULE" -> "message:MCAN:main_hb_amk" [label="TX"];

    "message:MCAN:INVA_ERR_1" [label="INVA_ERR_1\nID 0x441 (standard)\n2000 ms · 8 bytes · priority 4", style="rounded,filled", fillcolor="#E0E0E0"];
