digraph CAN_topology {
    rankdir=LR;
    graph [fontname="Helvetica", labelloc="t", bgcolor="transparent", fontcolor="#222222", label="MCAN — 500 kbit/s"];
    node [fontname="Helvetica", shape=box, style=filled, fillcolor="#D5D5D5", color="#777777", fontcolor="#111111"];
    edge [fontname="Helvetica", color="#2F70AD", fontcolor="#333333"];

    "node:MCAN:INVERTER_A" [label="INVERTER_A", style="filled,dashed"];
    "node:MCAN:INVERTER_B" [label="INVERTER_B", style="filled,dashed"];
    "node:MCAN:INVERTER_C" [label="INVERTER_C", style="filled,dashed"];
    "node:MCAN:INVERTER_D" [label="INVERTER_D", style="filled,dashed"];
    "node:MCAN:MAIN_MODULE" [label="MAIN_MODULE"];

    "message:MCAN:INVA_SET" [label="INVA_SET\nID 0x111 (standard)\n15 ms · 8 bytes · priority 1", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:MAIN_MODULE" -> "message:MCAN:INVA_SET" [label="TX"];
    "message:MCAN:INVA_SET" -> "node:MCAN:INVERTER_A" [label="RX", style=dashed];

    "message:MCAN:INVB_SET" [label="INVB_SET\nID 0x112 (standard)\n15 ms · 8 bytes · priority 1", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:MAIN_MODULE" -> "message:MCAN:INVB_SET" [label="TX"];
    "message:MCAN:INVB_SET" -> "node:MCAN:INVERTER_B" [label="RX", style=dashed];

    "message:MCAN:INVC_SET" [label="INVC_SET\nID 0x113 (standard)\n15 ms · 8 bytes · priority 1", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:MAIN_MODULE" -> "message:MCAN:INVC_SET" [label="TX"];
    "message:MCAN:INVC_SET" -> "node:MCAN:INVERTER_C" [label="RX", style=dashed];

    "message:MCAN:INVD_SET" [label="INVD_SET\nID 0x114 (standard)\n15 ms · 8 bytes · priority 1", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:MAIN_MODULE" -> "message:MCAN:INVD_SET" [label="TX"];
    "message:MCAN:INVD_SET" -> "node:MCAN:INVERTER_D" [label="RX", style=dashed];

    "message:MCAN:INVA_CRIT" [label="INVA_CRIT\nID 0x121 (standard)\n15 ms · 8 bytes · priority 1", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:MCAN:INVERTER_A" -> "message:MCAN:INVA_CRIT" [label="TX"];
    "message:MCAN:INVA_CRIT" -> "node:MCAN:MAIN_MODULE" [label="RX", style=dashed];

    "message:MCAN:INVB_CRIT" [label="INVB_CRIT\nID 0x122 (standard)\n15 ms · 8 bytes · priority 1", style="rounded,filled", fillcolor="#E0E0E0"];
