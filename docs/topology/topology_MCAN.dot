    "message:MCAN:INVC_ERR_2" -> "node:MCAN:MAIN_MODULE" [label="RX", style=dashed];

    "message:MCAN:INVD_ERR_2" [label="INVD_ERR_2\nID 0x454 (standard)\n2000 ms · 8 bytes · priority 4", style="rounded,filled", fillcolor="#E0E0E0"];
