digraph CAN_topology {
    rankdir=LR;
    graph [fontname="Helvetica", labelloc="t", bgcolor="transparent", fontcolor="#222222", label="SCAN — 500 kbit/s"];
    node [fontname="Helvetica", shape=box, style=filled, fillcolor="#D5D5D5", color="#777777", fontcolor="#111111"];
    edge [fontname="Helvetica", color="#2F70AD", fontcolor="#333333"];

    "node:SCAN:BOSCH_LWS" [label="BOSCH_LWS", style="filled,dashed"];
    "node:SCAN:DASHBOARD" [label="DASHBOARD"];

    "message:SCAN:LWS_Standard" [label="LWS_Standard\nID 0x2B0 (standard)\n10 ms · 5 bytes · priority 3", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:SCAN:BOSCH_LWS" -> "message:SCAN:LWS_Standard" [label="TX"];
    "message:SCAN:LWS_Standard" -> "node:SCAN:DASHBOARD" [label="RX callback", style=dashed, penwidth=2];

    "message:SCAN:LWS_Config" [label="LWS_Config\nID 0x7C0 (standard)\naperiodic · 2 bytes · priority 3", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:SCAN:DASHBOARD" -> "message:SCAN:LWS_Config" [label="TX"];
}
