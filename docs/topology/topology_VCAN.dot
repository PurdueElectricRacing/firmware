digraph CAN_topology {
    rankdir=LR;
    graph [fontname="Helvetica", labelloc="t", bgcolor="transparent", fontcolor="#222222", label="VCAN — 500 kbit/s"];
    node [fontname="Helvetica", shape=box, style=filled, fillcolor="#D5D5D5", color="#777777", fontcolor="#111111"];
    edge [fontname="Helvetica", color="#2F70AD", fontcolor="#333333"];

    "node:VCAN:A_BOX" [label="A_BOX"];
    "node:VCAN:BL_A_BOX" [label="BL_A_BOX"];
    "node:VCAN:BL_DASHBOARD" [label="BL_DASHBOARD"];
    "node:VCAN:BL_FRONT_DRIVELINE" [label="BL_FRONT_DRIVELINE"];
    "node:VCAN:BL_MAIN_MODULE" [label="BL_MAIN_MODULE"];
    "node:VCAN:BL_REAR_DRIVELINE" [label="BL_REAR_DRIVELINE"];
    "node:VCAN:BL_TORQUE_VECTOR" [label="BL_TORQUE_VECTOR"];
    "node:VCAN:BOOTLOADER" [label="BOOTLOADER", style="filled,dashed"];
    "node:VCAN:DAQ" [label="DAQ", style="filled,dashed"];
    "node:VCAN:DASHBOARD" [label="DASHBOARD"];
    "node:VCAN:DRIVELINE" [label="DRIVELINE"];
    "node:VCAN:E_METER" [label="E_METER", style="filled,dashed"];
    "node:VCAN:IZZE_IMU" [label="IZZE_IMU", style="filled,dashed"];
    "node:VCAN:MAIN_MODULE" [label="MAIN_MODULE"];
    "node:VCAN:PDU" [label="PDU"];
    "node:VCAN:TORQUE_VECTOR" [label="TORQUE_VECTOR"];

    "message:VCAN:a_box_fault_event" [label="a_box_fault_event\nID 0x1 (standard)\naperiodic · 5 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:A_BOX" -> "message:VCAN:a_box_fault_event" [label="TX"];
    "message:VCAN:a_box_fault_event" -> "node:VCAN:DASHBOARD" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:a_box_fault_event" -> "node:VCAN:MAIN_MODULE" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:a_box_fault_event" -> "node:VCAN:PDU" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:a_box_fault_event" -> "node:VCAN:TORQUE_VECTOR" [label="RX callback", style=dashed, penwidth=2];

    "message:VCAN:abox_init" [label="abox_init\nID 0x2 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:A_BOX" -> "message:VCAN:abox_init" [label="TX"];

    "message:VCAN:dash_init" [label="dash_init\nID 0x3 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:DASHBOARD" -> "message:VCAN:dash_init" [label="TX"];

    "message:VCAN:dashboard_fault_event" [label="dashboard_fault_event\nID 0x4 (standard)\naperiodic · 5 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:DASHBOARD" -> "message:VCAN:dashboard_fault_event" [label="TX"];
    "message:VCAN:dashboard_fault_event" -> "node:VCAN:A_BOX" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:dashboard_fault_event" -> "node:VCAN:MAIN_MODULE" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:dashboard_fault_event" -> "node:VCAN:PDU" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:dashboard_fault_event" -> "node:VCAN:TORQUE_VECTOR" [label="RX callback", style=dashed, penwidth=2];

    "message:VCAN:main_init" [label="main_init\nID 0x5 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:MAIN_MODULE" -> "message:VCAN:main_init" [label="TX"];

    "message:VCAN:main_module_fault_event" [label="main_module_fault_event\nID 0x6 (standard)\naperiodic · 5 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:MAIN_MODULE" -> "message:VCAN:main_module_fault_event" [label="TX"];
    "message:VCAN:main_module_fault_event" -> "node:VCAN:A_BOX" [label="RX callback", style=dashed, penwidth=2];
