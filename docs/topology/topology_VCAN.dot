    "node:VCAN:TORQUE_VECTOR" -> "message:VCAN:tv_init" [label="TX"];

    "message:VCAN:bl_main_module_start" [label="bl_main_module_start\nID 0x20 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:BOOTLOADER" -> "message:VCAN:bl_main_module_start" [label="TX"];
    "message:VCAN:bl_main_module_start" -> "node:VCAN:BL_MAIN_MODULE" [label="RX", style=dashed];
    "message:VCAN:bl_main_module_start" -> "node:VCAN:MAIN_MODULE" [label="RX callback", style=dashed, penwidth=2];

    "message:VCAN:bl_main_module_data" [label="bl_main_module_data\nID 0x21 (standard)\naperiodic · 7 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:BOOTLOADER" -> "message:VCAN:bl_main_module_data" [label="TX"];
    "message:VCAN:bl_main_module_data" -> "node:VCAN:BL_MAIN_MODULE" [label="RX", style=dashed];

    "message:VCAN:bl_main_module_resp" [label="bl_main_module_resp\nID 0x22 (standard)\naperiodic · 5 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:BL_MAIN_MODULE" -> "message:VCAN:bl_main_module_resp" [label="TX"];
    "message:VCAN:bl_main_module_resp" -> "node:VCAN:BOOTLOADER" [label="RX", style=dashed];

    "message:VCAN:bl_dashboard_start" [label="bl_dashboard_start\nID 0x23 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
