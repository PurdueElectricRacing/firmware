    "message:VCAN:main_module_fault_event" -> "node:VCAN:PDU" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:main_module_fault_event" -> "node:VCAN:TORQUE_VECTOR" [label="RX callback", style=dashed, penwidth=2];

