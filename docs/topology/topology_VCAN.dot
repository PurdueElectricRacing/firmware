    "message:VCAN:pdu_fault_event" -> "node:VCAN:MAIN_MODULE" [label="RX callback", style=dashed, penwidth=2];
    "message:VCAN:pdu_fault_event" -> "node:VCAN:TORQUE_VECTOR" [label="RX callback", style=dashed, penwidth=2];

    "message:VCAN:pdu_init" [label="pdu_init\nID 0x8 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:PDU" -> "message:VCAN:pdu_init" [label="TX"];

    "message:VCAN:torque_vector_fault_event" [label="torque_vector_fault_event\nID 0x9 (standard)\naperiodic · 5 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
