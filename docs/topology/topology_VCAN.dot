    "message:VCAN:bl_dashboard_data" -> "node:VCAN:BL_DASHBOARD" [label="RX", style=dashed];

    "message:VCAN:bl_dashboard_resp" [label="bl_dashboard_resp\nID 0x25 (standard)\naperiodic · 5 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
    "node:VCAN:BL_DASHBOARD" -> "message:VCAN:bl_dashboard_resp" [label="TX"];
    "message:VCAN:bl_dashboard_resp" -> "node:VCAN:BOOTLOADER" [label="RX", style=dashed];

    "message:VCAN:bl_torque_vector_start" [label="bl_torque_vector_start\nID 0x26 (standard)\naperiodic · 4 bytes · priority 0", style="rounded,filled", fillcolor="#E0E0E0"];
