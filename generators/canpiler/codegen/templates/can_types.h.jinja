#ifndef CAN_TYPES_H
#define CAN_TYPES_H

/**
 * @file can_types.h
 * @brief Auto-generated custom types and enums for the CAN library.
 * @note This file is auto-generated; do not modify manually.
 * @author Irving Wang (irvingw@purdue.edu)
 */

#include <stdint.h>

{% for type in types %}
{% if type.choices %}
typedef enum : {{ type.base_type }} {
{% for choice in type.choices or [] %}
    {{ type.name|enum_prefix }}_{{ choice.name|upper }} = {{ choice.value }},
{% endfor %}
} {{ type.name }};
{% else %}
typedef {{ type.base_type }} {{ type.name }};
{% endif %}

{% endfor %}
#endif // CAN_TYPES_H
